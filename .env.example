# Airtable Configuration
# Copy this file to .env and fill in your actual tokens

# Public token (read-only for customer portal)
AIRTABLE_PUBLIC_TOKEN=pat_your_public_token_here

# Admin token (read-write for admin dashboard)
AIRTABLE_ADMIN_TOKEN=pat_your_admin_token_here

# Server configuration (optional)
NODE_ENV=development
PORT=3000
